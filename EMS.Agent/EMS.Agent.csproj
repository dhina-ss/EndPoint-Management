<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <!-- net8.0-windows10.0.19041.0 + WinForms: WinForms powers the activation
         login window; the Windows 10 SDK target additionally projects the WinRT
         Windows.Devices.Geolocation API used for optional GPS location. The
         agent is already Windows-only, so this only formalizes that. -->
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <!-- GUI subsystem: never allocate a console window. The Worker SDK
         defaults to a console Exe, which flashes a CMD window whenever the
         agent is launched outside the Service Control Manager (the post-install
         login window and the per-user usage-tracker task). WinExe suppresses
         that entirely; the service still logs to the Event Log and the tracker
         to its file log. -->
    <OutputType>WinExe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-EMS.Agent-0fdb5ff2-d827-4c2a-9646-89e123494e24</UserSecretsId>
    <!-- The Lance branding: the exe (and its Add/Remove Programs entry) shows
         the TL mark. -->
    <ApplicationIcon>TheLance.ico</ApplicationIcon>
    <AssemblyTitle>The Lance Endpoint</AssemblyTitle>
    <Product>The Lance Endpoint</Product>
    <Company>The Lance</Company>
    <!-- Single source of truth for the agent version. The agent reports this at
         runtime (Assembly version -> heartbeat -> console "Agent Version"), and
         the installer reads it back off the compiled exe (see EMS.Agent.iss),
         so bumping it here is the only place a release version changes. Override
         at build time with -p:Version=x.y.z if needed. -->
    <Version>1.0.23</Version>
  </PropertyGroup>

  <!-- Branding assets loaded at runtime for the tray icon and activation window. -->
  <ItemGroup>
    <EmbeddedResource Include="TheLance.ico" />
    <EmbeddedResource Include="Login\thelance-logo.png" />
    <EmbeddedResource Include="thelance-logo-white.png" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.*" />
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.*" />
    <PackageReference Include="System.Management" Version="8.0.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\EMS.Shared\EMS.Shared.csproj" />
  </ItemGroup>
</Project>
