{
  "ApiSettings": {
    "BaseUrl": "https://endpoint-management.onrender.com/",
    "RegisterEndpoint": "/api/devices/register",
    "HeartbeatEndpoint": "/api/devices/heartbeat",
    "HeartbeatIntervalSeconds": 60,
    "TimeoutSeconds": 30,
    "MaxRetryAttempts": 3,
    "RetryDelaySeconds": 5,
    "PollingIntervalMinutes": 10,
    "AppUsageEndpoint": "/api/devices/app-usage",
    "AppUsageSampleIntervalSeconds": 20,
    "AppUsageUploadIntervalMinutes": 5
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    },
    "EventLog": {
      "LogLevel": {
        "Default": "Information"
      }
    }
  }
}
