{
  "ConnectionStrings": {
    "DefaultConnection": "Host=<your-project>.neon.tech;Database=<your-database>;Username=<your-user>;Password=<YOUR_NEON_PASSWORD>;SSL Mode=Require;Channel Binding=Require"
  },
  "DatabaseSettings": {
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "Cors": {
    "AllowedOrigins": ["http://localhost:5173"]
  },
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "AllowedHosts": "*"
}
