{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "EMS.API": "Information",
      "Program": "Information",
      "Microsoft.Hosting.Lifetime": "Information",
      "Microsoft.EntityFrameworkCore": "Warning"
    }
  },
  "DatabaseSettings": {
    "MaxRetryCount": 5,
    "MaxRetryDelaySeconds": 10,
    "CommandTimeoutSeconds": 30,
    "EnableSensitiveDataLogging": false
  },
  "Cors": {
    "AllowedOrigins": []
  }
}
